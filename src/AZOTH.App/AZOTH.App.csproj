<!--
  AZOTH.App: the Avalonia desktop application (tray, donut toolbar, settings window).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AZOTH</AssemblyName>
    <RootNamespace>AZOTH.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\azoth.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AZOTH.Core\AZOTH.Core.csproj" />
    <ProjectReference Include="..\AZOTH.Engines\AZOTH.Engines.csproj" />
    <ProjectReference Include="..\AZOTH.Platform.Windows\AZOTH.Platform.Windows.csproj" />
    <ProjectReference Include="..\AZOTH.Platform.Linux\AZOTH.Platform.Linux.csproj" />
    <ProjectReference Include="..\AZOTH.Platform.MacOS\AZOTH.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="SharpHook" />
  </ItemGroup>

  <PropertyGroup>
    <AZOTHNativeWayland Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">true</AZOTHNativeWayland>
    <DefineConstants Condition="'$(AZOTHNativeWayland)' == 'true'">$(DefineConstants);AZOTH_NATIVE_WAYLAND</DefineConstants>
  </PropertyGroup>

  <!-- Linux-only Wayland packages to keep Windows and macOS binaries small -->
  <ItemGroup Condition="'$(AZOTHNativeWayland)' == 'true'">
    <PackageReference Include="Avalonia.Wayland" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- License and notices shown on the About page. -->
    <AvaloniaResource Include="..\..\LICENSE" Link="Assets\LICENSE" />
    <AvaloniaResource Include="..\..\THIRD-PARTY-NOTICES.md" Link="Assets\THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AZOTH.App.Tests" />
  </ItemGroup>

  <!-- Native debug symbols from NuGet packages (SkiaSharp, HarfBuzz: ~100 MB) are useless to users. -->
  <Target Name="AZOTHRemoveNativeSymbols" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_AZOTHNativePdb Include="$(PublishDir)lib*.pdb" />
    </ItemGroup>
    <Delete Files="@(_AZOTHNativePdb)" />
  </Target>

  <!-- Independent product and update URLs from Directory.Build.props. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryUrl</_Parameter1>
      <_Parameter2>$(AZOTHRepositoryUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateRepositoryUrl</_Parameter1>
      <_Parameter2>$(AZOTHUpdateRepositoryUrl)</_Parameter2>
    </AssemblyAttribute>
    <!-- Published builds (installer, portable zip) set -p:AZOTHRelease=true: only they register Explorer and startup
         entries (UpdateService.IsReleaseBuild), so running from source leaves the user's system alone. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(AZOTHRelease)' == 'true'">
      <_Parameter1>AZOTHRelease</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
