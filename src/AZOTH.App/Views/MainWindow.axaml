<!-- Main window = settings: navigation on the left, current page on the right. Closing hides to the tray. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AZOTH.App.ViewModels"
        xmlns:c="using:AZOTH.App.Controls"
        x:Class="AZOTH.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AZOTH"
        Icon="avares://AZOTH/Assets/Icons/azoth.ico"
        Width="1080" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid Background="{DynamicResource SurfaceBrush}">
    <Grid x:Name="MainInterface" ColumnDefinitions="230,*"
          IsVisible="{Binding #LaunchLogo.IsContentReady}"
          Classes.ready="{Binding #LaunchLogo.IsContentReady}">
      <Grid.Styles>
        <Style Selector="Grid#MainInterface">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="Transitions">
            <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
          </Setter>
        </Style>
        <Style Selector="Grid#MainInterface.ready"><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="Window.reduced-motion Grid#MainInterface">
          <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
      </Grid.Styles>
      <!-- Navigation -->
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="14,18">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,0,20">
            <Image Source="avares://AZOTH/Assets/Icons/azoth.png" Width="38" Height="38" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="AZOTH" FontSize="20" FontWeight="Bold" />
              <TextBlock Classes="caption" Text="{DynamicResource app.tagline}" />
            </StackPanel>
          </StackPanel>
          <!-- Bottom: the running version, and a download button when a newer release is out. -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="4,12,4,0">
            <!-- Accent for required and recommended updates, plain for optional ones; a pill says which -->
            <Button x:Name="UpdateButton" Classes.accent="{Binding !Updates.IsOptional}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding Updates.IsUpdateAvailable}"
                    ToolTip.Tip="{Binding UpdateTip}">
              <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource DangerBrush}" IsVisible="{Binding Updates.IsRequired}">
                  <TextBlock Text="{DynamicResource update.pill.Required}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceAltBrush}" IsVisible="{Binding Updates.IsOptional}">
                  <TextBlock Classes="caption" Text="{DynamicResource update.pill.Optional}" FontSize="11" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Download}" />
                  <TextBlock Text="{Binding UpdateText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Button>
            <!-- Maintainer attribution; project release/support destinations are not configured yet. -->
            <Button Classes="navlink" HorizontalAlignment="Stretch" Click="OnOpenGitHub" ToolTip.Tip="{Binding RepositoryUrl}">
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.GitHub}" />
                <TextBlock Text="Veilric" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="VersionLabel" Classes="caption" Margin="8,0,0,0" Text="{Binding VersionText}" />
          </StackPanel>
          <ListBox Classes="nav" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <PathIcon Width="17" Height="17" Data="{Binding Icon}" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Page -->
      <ScrollViewer Grid.Column="1" x:Name="PageScroller" VerticalScrollBarVisibility="{Binding PageScroll}">
        <ContentControl Classes="page" Content="{Binding CurrentPage}" Margin="32,26,32,32" MaxWidth="980" HorizontalAlignment="Stretch" />
      </ScrollViewer>
    </Grid>
    <!-- A separate launch stage in this window: main content is hidden until it finishes. -->
    <Border x:Name="LaunchSurface" Background="{DynamicResource SurfaceBrush}"
            IsVisible="{Binding !#LaunchLogo.IsContentReady}">
      <c:StartupLogo x:Name="LaunchLogo" Source="avares://AZOTH/Assets/Icons/azoth.png"
                     Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
