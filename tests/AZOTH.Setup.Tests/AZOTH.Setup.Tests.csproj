<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AZOTH.Setup\AZOTH.Setup.csproj" />
    <!-- What Setup hands over must be what the app reads (CommandLine, EngineDownloads, LocalizationService). -->
    <ProjectReference Include="..\..\src\AZOTH.App\AZOTH.App.csproj" Aliases="app" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../AZOTH.App.Tests/Fixtures/UpstreamWhatsNew/**" Link="Assets/WhatsNew/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
